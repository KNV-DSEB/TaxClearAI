ENVIRONMENT=development
PORT=8000
APP_TITLE=Nền tảng hỗ trợ chấm dứt hoạt động HKD/DN
API_RATE_LIMIT_PER_MINUTE=60
CHATBOT_RATE_LIMIT_PER_MINUTE=20

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_db

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15

CHATBOT_LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key
MODEL_GUARDRAIL=gemini-2.5-flash-lite
MODEL_ANSWER=gemini-2.5-flash
# Defaults to MODEL_GUARDRAIL when unset.
MODEL_CLASSIFIER=
SURVEY_AI_ENABLED=true
CHATBOT_TOP_K=6
CHATBOT_MIN_RETRIEVAL_SCORE=1
CHATBOT_MOCK_MODE=false
CHATBOT_FAILSAFE=khong_chac_chan
CHATBOT_GUARDRAIL_CACHE_SIZE=512
LAW_SOURCE_ALLOWLIST=congbao.chinhphu.vn,g7.cdnchinhphu.vn,vanban.chinhphu.vn,datafiles.chinhphu.vn,vbpl.vn,xaydungchinhsach.chinhphu.vn
LAW_MAX_AGE_DAYS=30
AI_PROVIDER_DATA_TERMS_ACK=false
